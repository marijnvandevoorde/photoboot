# Photoboot settings. Copy to .env and fill in what you need:
#   cp .env.example .env
# Docker Compose loads .env into the container; `npm start` / `npm run dev`
# read it too. Empty values fall back to the default shown in the comment.
# Never commit .env (it's gitignored).

# ---------- Server ----------

# Public origin of the booth, used in QR codes and emailed links.
# Default: derived from each request (fine for local use).
BASE_URL=
# Origin for emailed setup / gallery links if it differs from BASE_URL.
PUBLIC_URL=
# HTTP port (default 8080).
PORT=

# ---------- Storage ----------
# In Docker these are set by docker-compose.yml (/data/...); leave empty there.

# Where shared photos are stored (default ./shares).
SHARE_DIR=
# Where the database lives (default ./events, next to SHARE_DIR).
EVENTS_DIR=
# SQLite file (default EVENTS_DIR/photoboot.db).
DB_PATH=
# Refuse uploads once photos take this many MB (default 5000).
SHARE_MAX_MB=

# ---------- Photo retention ----------

# Days a freely shared photo is kept (default 30; 0 = forever).
SHARE_TTL_DAYS=
# Days a paid event keeps its photos (default 365; 0 = forever).
PAID_RETENTION_DAYS=

# ---------- Admin (/admin) ----------

# Long random secret; log in to /admin with it plus an authenticator code.
# Generate one with: openssl rand -base64 24
ADMIN_TOKEN=
# Set to 1 for one restart to forget the enrolled authenticator (lost phone),
# then empty it again.
ADMIN_TOTP_RESET=

# ---------- Sharing ----------

# Optional: require this token for uploads that don't come from an event booth.
UPLOAD_TOKEN=
# Origins of the iOS / Android app allowed to call the API
# (default capacitor://localhost,https://localhost).
CORS_ORIGINS=

# ---------- Event galleries: price ----------

# Web price of an event gallery in cents (default 1900 = €19).
EVENT_PRICE_CENTS=
# ISO currency of that price (default eur).
EVENT_CURRENCY=

# ---------- Email (Brevo) ----------

# Brevo → SMTP & API → API keys. Without it, event emails are only logged.
BREVO_API_KEY=
# Sender address; must be a verified sender in Brevo
# (default booth@small-victories.co).
MAIL_FROM=
# Sender name (default Photoboot).
MAIL_FROM_NAME=

# ---------- Payments: Stripe (web) ----------

# Stripe → Developers → API keys (sk_live_… or sk_test_…).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<host>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded).
STRIPE_WEBHOOK_SECRET=
# 1 = let Stripe Tax add VAT (needs Stripe Tax set up); the price includes it.
STRIPE_AUTOMATIC_TAX=

# ---------- Payments: Apple in-app purchase (iOS app) ----------

# Bundle id of the app (default co.smallvictories.photoboot).
APPLE_BUNDLE_ID=
# Product id of the consumable (default co.smallvictories.photoboot.eventgallery).
APPLE_PRODUCT_ID=
# 0 = refuse Sandbox / TestFlight purchases (default: accepted).
APPLE_ALLOW_SANDBOX=

# ---------- Building the app (read by Vite at build time, not the server) ----------

# Server the iOS / Android app talks to (default https://boot.small-victories.co).
VITE_SERVER_URL=
# Must match APPLE_PRODUCT_ID (default co.smallvictories.photoboot.eventgallery).
VITE_APPLE_PRODUCT_ID=

# ---------- Local development ----------

# 1 = plain HTTP on localhost instead of HTTPS on the LAN (used by print.sh).
PHOTOBOOT_LOCAL=
