# sv-deploy config: ships origin/main to the cluster sv-oke (boot.small-victories.co).
# See ../Oracle/deploy/README.md. Run: npm run deploy (or npm run deploy:check).
APP=photoboot
# name|build context|Dockerfile|extra buildx args
IMAGES='
photoboot|.|Dockerfile|
'
TARGETS="apps/photoboot/photoboot=photoboot"
SMOKE_URLS="https://boot.small-victories.co/"
MANIFESTS="k8s/apps/tier2/stacks.py"
