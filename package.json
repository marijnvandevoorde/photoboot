{
  "name": "photoboot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "app:sync": "vite build && cap sync",
    "app:open": "cap open ios"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.19.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^20.14.5",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "qrcode-generator": "^2.0.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
